{
  "name": "dotnovi",
  "version": "1.0.0",
  "description": "dotNOVI - A simple Node.js application for NOVI Hogeschool DevOps course",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "devops"
  ],
  "author": "NOVI Hogeschool",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion": "^1.1.11",
    "minimatch": {
      "brace-expansion": "^1.1.11"
    },
    "glob": {
      "minimatch": "^3.1.2",
      "brace-expansion": "^1.1.11"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}